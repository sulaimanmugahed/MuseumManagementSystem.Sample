@model LoginViewModel
@{
    Layout = null;
    var isRTL = CultureInfo.CurrentCulture.Name.StartsWith("ar");

}

<!DOCTYPE html>
<html lang="@(isRTL ? "ar" : "en")" dir="@(isRTL ? "rtl" : "ltr")">
<head>

    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title>Login</title>


    <link href="~/css/style.css" rel="stylesheet" />

    <link href="~/css/login.css" rel="stylesheet" />

    @if (isRTL)
    {
        <style>
            .input-div > div > h5 {
            right: 10px;
            }
        </style>
    }
    else
    {
        <style>
            .input-div > div > h5 {
                left: 10px;
            }
        </style>
    }

</head>
<body>
   

    <img class="wave" src="/images/wave.png">
	<div class="container">

		<div class="img">
			<img src="/images/login-bg.svg">
		</div>
		<div class="login-content">
            <partial name="_SelectLanguagePartial" />
            <form style="margin-top:32px;" id="account" method="post">
           		<div class="input-div one">
           		   <div class="i">
           		   		<i class="fas fa-user"></i>
           		   </div>
           		   <div  class="div" >
           		   		<h5 >@localizer["username"]</h5>
                        <input asp-for="EmailOrUsername"   aria-required="true"   type ="text" class="input"/>

           		   </div>

           		</div>
                <span asp-validation-for="EmailOrUsername" class="text-danger"></span>

           		<div class="input-div pass">
           		   <div class="i"> 
           		    	<i class="fas fa-lock"></i>
           		   </div>
           		   <div class="div">
                        <h5>@localizer["password"]</h5>
                        <input type="password" class="input" asp-for="Password"  aria-required="true"  />

            	   </div>


            	</div>
                <span asp-validation-for="Password" class="text-danger"></span>

                <br>
                <div class="checkbox mb-3 ">
                    <label style="font-weight:bold;color:#555;" asp-for="RememberMe" class="form-label">
                        <input style="margin-inline:20px;" class="form-check-input" asp-for="RememberMe" />
                        @Html.DisplayNameFor(m => m.RememberMe)
                    </label>
                </div>
                <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

                <input id="login-submit" type="submit"  class="login-btn" value=@(localizer["login"])>
            </form>
        </div>
    </div>




