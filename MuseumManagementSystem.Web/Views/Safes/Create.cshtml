 @model SafeCreateViewModel

@{
    ViewData["Title"] = "Create";

}

<div class="page-header pb-2">
    <h4>@localizer["create_safe_title"]</h4>
    <back-button />
</div>

<div class="card">
    <div class="card-body col-12">
        <form asp-action="Create" method="post">
            <div class="row  pb-4">
                <div class="col-lg-6 col-md-6 col-sm-12 mb-4">
                    <label asp-for="Name" class="form-label"></label>
                    <br />

                    <input type="text" asp-for="Name" class="form-control" placeholder="@localizer["safe_name_placeholder"]" required>
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="col-lg-6 col-md-6 col-sm-12 mb-4">
                    <label asp-for="SelectedStowage" class="form-label"></label>
                    <br />
                    <select id="singal_option" asp-for="SelectedStowage" asp-items="@Model.Stowages" placeholder="@localizer["stwage_placeholder"]">
                        <option disabled selected></option>
                    </select>
                    <span asp-validation-for="SelectedStowage" class="text-danger"></span>
                </div>
            </div>
            <button type="submit" value="Create" class="btn btn-primary ">
                <span class="btnText">@localizer["create"]</span>
            </button>

        </form>
    </div>
</div>


@section Scripts {
    @{

        await Html.RenderPartialAsync("_ValidationScriptsPartial");
        await Html.RenderPartialAsync("_FormScriptsPartial");
    }



}
