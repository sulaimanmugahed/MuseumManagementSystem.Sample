
@{
    var currentCulture = CultureInfo.CurrentCulture.Name;
    var isRTL = currentCulture.StartsWith("ar");
}


<!DOCTYPE html>
<html lang="@(isRTL ? "ar" : "en")" dir="@(isRTL ? "RTL" : "LTR")">

<head>

    <link href="~/lib/sweetalert2/sweetalert2.min.css" rel="stylesheet" />
    <link href="~/lib/bootstrap-datepicker/css/bootstrap-datepicker3.min.css" rel="stylesheet" />
    <link href="~/lib/datatable/buttons.datatables.min.css" rel="stylesheet" />
    <link href="~/lib/datatable/fixedheader.datatables.min.css" rel="stylesheet" />
    <link href="~/lib/datatable/jquery.datatables.min.css" rel="stylesheet" />
    @await RenderSectionAsync("Styles", required: false)
    @if (isRTL)
    {
        <link href="~/css/datatable-rtl.css" rel="stylesheet" />

    }
    <link href="~/css/site.css" rel="stylesheet" />
    <link href="~/css/style.css" rel="stylesheet" />
    <!-- Required meta tags -->
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title>@ViewData["Title"]</title>
    <!-- plugins:css -->
    <link rel="stylesheet" href="~/vendors/mdi/css/materialdesignicons.min.css">
    <link rel="stylesheet" href="~/vendors/css/vendor.bundle.base.css">
    <link href="~/css/virtual-select.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/chartjs/Chart.css" />
    <link href="~/css/lightbox.min.css" rel="stylesheet" />
    <!-- End layout styles -->
    <link rel="shortcut icon" href="~/images/favicon.ico" />
</head>

<body>

    @if (User.Identity!.IsAuthenticated)
    {


        <partial name="_NavbarPartial" />


        <div class="container-fluid page-body-wrapper @(isRTL ? "rtl" : "ltr")">


            <partial name="_SidebarPartial" />


            <div class="main-panel">
                <div class="content-wrapper">
                    @RenderBody()
                </div>
                <partial name="_FooterPartial" />
            </div>


        </div>
    }
    @* else
    {

    @RenderBody()


    } *@

    <!-- plugins:js -->
    <script src="~/vendors/js/vendor.bundle.base.js"></script>
    <!-- endinject -->
    <!-- Plugin js for this page -->
    <script src="~/vendors/chart.js/Chart.min.js"></script>
    <script src="~/js/jquery.cookie.js" type="text/javascript"></script>
    <!-- End plugin js for this page -->
    <script src="~/lib/bootbox.js/bootbox.js"></script>
    <!-- inject:js -->
    <script src="~/js/off-canvas.js"></script>
    <script src="~/js/hoverable-collapse.js"></script>
    <script src="~/js/misc.js"></script>
    <!-- endinject -->
    <!-- Custom js for this page -->
    <script src="~/js/dashboard.js"></script>
    <script src="~/js/todolist.js"></script>

    <script src="~/lib/bootbox.js/bootbox.js"></script>
    <script src="~/lib/bootbox.js/bootbox.min.js"></script>
    <!-- End custom js for this page -->

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/lib/sweetalert2/sweetalert2.all.min.js"></script>
    <script src="~/lib/sweetalert2/sweetalert2.min.js"></script>
    <script src="~/js/shared/constants.js"></script>
    <script src="~/lib/bootstrap-datepicker/js/bootstrap-datepicker.min.js"></script>
    
    @{
        <script src="@($"/js/shared/{currentCulture.ToLower()}.js")"></script>
        if (isRTL)
        {
            <script src="~/lib/bootstrap-datepicker/locales/bootstrap-datepicker.ar.min.js"></script>
        }
      
        <script src="~/js/shared/helpers.js"></script>

        await RenderSectionAsync("Scripts", required: false);

    }

</body>

</html>
