<li class="nav-item nav-profile">
    <a asp-controller="Profile" asp-action="Index" class="nav-link">
        <div class="nav-profile-image">
            <img src="/@Url.Content(ViewBag.ProfilePicture)" alt="profile">
            <span class="login-status online"></span>
            <!--change to offline or busy as needed-->
        </div>
        <div class="nav-profile-text d-flex flex-column">
            <span class="font-weight-bold mb-2">@ViewBag.Name </span>
            <span class="text-secondary text-small">@ViewBag.Role</span>
        </div>
    </a>
</li>