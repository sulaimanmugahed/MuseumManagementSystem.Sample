@model EditUserViewModel
@inject IViewLocalizer localizer
@{
    ViewData["Title"] = "Edit";
}



<div class="page-header pb-2">
    <h4>@localizer["editUserTitle"]</h4>
    <back-button />

</div>
<div class="card">
    <div class="card-body col-12">

        <form asp-action="Edit" method="post" id="form">
            <input type="hidden" asp-for="Id" />
            <div class="row pb-4">
                <div class="col-lg-4 col-md-6 col-sm-12 pb-4">
                    <label asp-for="UserName" class="form-label"></label>
                    <input asp-for="UserName" class="form-control" placeholder="@localizer["username_placeholder"]">
                    <span asp-validation-for="UserName" class="text-danger"></span>
                </div>

                <div class="col-lg-4 col-md-6 col-sm-12 pb-4">
                    <label asp-for="FirstName" class="form-label"></label>
                    <input asp-for="FirstName" class="form-control" placeholder="@localizer["firstname_placeholder"]">
                    <span asp-validation-for="FirstName" class="text-danger"></span>
                </div>

                <div class="col-lg-4 col-md-6 col-sm-12 pb-4">
                    <label asp-for="LastName" class="form-label"></label>
                    <input asp-for="LastName" class="form-control" placeholder="@localizer["lastname_placeholder"]">
                    <span asp-validation-for="LastName" class="text-danger"></span>
                </div>

                <div class="col-lg-4 col-md-6 col-sm-12 pb-4">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" class="form-control" placeholder="@localizer["email_placeholder"]">
                    <span asp-validation-for="Email" class="text-danger"></span>

                </div>

                <div class="col-lg-4 col-md-6 col-sm-12 pb-4">
                    <label asp-for="PhoneNumber" class="form-label"></label>
                    <input asp-for="PhoneNumber" class="form-control" placeholder="@localizer["phone_number_placeholder"]">
                    <span asp-validation-for="PhoneNumber" class="text-danger"></span>

                </div>

                <div class="col-lg-4 col-md-6 col-sm-12 pb-4">
                    <label asp-for="SelectedRole" class="form-label"></label>
                    <br>
                    <select id="singal_option" asp-for="SelectedRole" asp-items="Model.Roles" placeholder="@localizer["role_placeholder"]">
                        <option disabled selected></option>
                    </select>
                    <span asp-validation-for="SelectedRole" class="text-danger"></span>
                </div>

                <div class="col-lg-4 col-md-6 col-sm-12 pb-4">
                    <label asp-for="NewPassword" class="form-label"></label>
                    <input type="password" asp-for="NewPassword" class="form-control" placeholder="@localizer["password_placeholder"]">
                    <span asp-validation-for="NewPassword" class="text-danger"></span>

                </div>

                <div class="col-lg-4 col-md-6 col-sm-12 pb-4">
                    <label asp-for="ConfirmNewPassword" class="form-label"></label>
                    <input type="password" asp-for="ConfirmNewPassword" class="form-control" placeholder="@localizer["confirm_password_placeholder"]">
                    <span asp-validation-for="ConfirmNewPassword" class="text-danger"></span>

                </div>







                <div class="col-12">
                    <input type="submit" value="@localizer["save"]" class="btn btn-primary mt-4 " />
                </div>



            </div>


        </form>


    </div>
</div>








