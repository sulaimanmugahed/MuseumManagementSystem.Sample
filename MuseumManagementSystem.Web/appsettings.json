{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "ImageSearchAppSettings": {
    "Host": "localhost",
    "Port": 5010,
    "Scheme" :"http"
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost,9433;Database=DockerComposeDemo;User Id=sa;Password=Abcd12345;Trust Server Certificate=true",
    "RedisConnection": "localhost:5005"
  },
  "Localaization": {
    "SupportedCultures": [ "ar-YE", "en-US", "ru","fr" ],
    "DefaultRequestCulture": "ar-YE"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "Using": [
      "Serilog.Enrichers.ClientInfo",
      "Serilog.Exceptions"
    ],
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs\\log-.txt",
          "rollingInterval": "Day",
          "rollOnFileSizeLimit": true,
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter,Serilog.Formatting.Compact"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithExceptionDetails"
    ],
    "Properties": {
      "ApplicationName": "TaizMuseum.Web"
    }
  }
}